# Sentinel V4 — first-commit guardrails (prepared Oct 26, 2026, before kickoff)
# Never commit the virtualenv, caches, temp files, or the pre-existing
# Oct 22 Laya training artefacts. See v4-repo-separation-decision-oct-26-2026.md.
.venv/
__pycache__/
*.pyc
.tmp/
.env
*.log
.cache/
*.db
*.db-wal
*.db-shm

# Training directory: ignore all contents by default to exclude pre-existing artefacts & 800MB weights
training/*
# Allow ONLY the hackathon-week evaluation files
!training/evaluate.py
!training/data_test.jsonl
!training/baseline_metrics.json
!training/baseline_predictions.json
!training/tuned_metrics.json
!training/tuned_predictions.json
