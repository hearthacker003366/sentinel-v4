# Sentinel V4 — Environment Configuration
# Copy to .env and configure your keys (never commit .env to git)

# Meta Model API Key for System-2 Reasoning (pinned model: muse-spark-1.3)
# Accepts either META_MODEL_API_KEY or MUSE_API_KEY
META_MODEL_API_KEY=your_meta_model_api_key_here
# MUSE_API_KEY=your_muse_api_key_here

# Meta Model API Endpoint (Default: https://api.meta.ai/v1/chat/completions)
META_MODEL_API_URL=https://api.meta.ai/v1/chat/completions

# Telegram Bot Gateway for HITL Containment Cards (Optional)
# TELEGRAM_BOT_TOKEN: Bot token obtained from @BotFather
# TELEGRAM_ALLOWED_USER_IDS: Comma-separated list of authorized numeric Telegram User IDs
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# Local Triage Device (cpu or cuda)
LAYA_DEVICE=cuda
